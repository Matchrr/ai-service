APP_NAME=Matchr AI Service
APP_ENV=development
API_PREFIX=/api
PORT=8080
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# Models
# Preferred: GEMINI_API_KEY (Google AI Studio / Gemini). GOOGLE_API_KEY and
# GENERATIVE_LANGUAGE_API_KEY also work. OPENAI_API_KEY is only used for Gemini
# if it does not look like an OpenAI key (sk-...).
GEMINI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
KONG_GATEWAY_URL=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

# Data + job/event harvest
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SERPAPI_API_KEY=
NUTRIENT_API_KEY=

# Xano job catalog (vector column on matchrr_job_position)
XANO_API_URL=
XANO_API_KEY=
XANO_JOBS_TABLE=matchrr_job_position
XANO_SEARCH_RUN_TABLE=matchrr_job_search_run
XANO_CHUNKS_TABLE=matchrr_profile_chunk
XANO_COVER_LETTERS_TABLE=matchrr_cover_letter
# Optional Xano API endpoint for vector search. Leave empty to brute-force match jobs.
# The endpoint should run a custom function that does vector search on matchrr_job_position.
XANO_MATCH_ENDPOINT=match_jobs
XANO_CHUNK_MATCH_FUNCTION=

HARVEST_STANDING_HOURS=72
HARVEST_STANDING_SLOTS=20
HARVEST_CACHE_HOURS=12
HARVEST_STALE_HOURS=96
HARVEST_PAGES=2

BACKEND_URL=http://localhost:4000
MATCHR_SERVICE_SECRET=matchr-dev
